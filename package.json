    "url": "https://github.com/lovchinsky/requirements-discovery/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
