{
  "name": "requirements-discovery",
  "version": "1.0.0",
  "private": true,
  "description": "Nonlinear requirements discovery for Claude Code, backed by Argdown.",
  "homepage": "https://github.com/lovchinsky/requirements-discovery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovchinsky/requirements-discovery.git"
  },
