  },
  "dependencies": {
    "@argdown/core": "2.0.1",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "lodash-es": "4.18.1"
